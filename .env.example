# Copie para .env (local) ou cadastre como Secrets no GitHub.

# --- Instagram (Graph API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# login do Facebook: https://graph.facebook.com/v23.0 | login do Instagram: https://graph.instagram.com/v23.0
IG_GRAPH_BASE=https://graph.facebook.com/v23.0
IG_HANDLE=@comovotadeputado

# URL pública onde ficam as imagens (pasta data/drafts do repositório)
# as imagens ficam no branch "midia" (scripts/midia.sh)
# ex.: https://raw.githubusercontent.com/SEU_USUARIO/como-vota/midia
PUBLIC_BASE_URL=

# horários da fila de publicação (Brasília); "imediato" publica assim que você aprova
HORARIOS_PUBLICACAO=11:45,18:45

# --- Telegram (aprovação) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- IA para resumir a ementa (opcional) ---
ANTHROPIC_API_KEY=
IA_MODELO=claude-haiku-5-5

# --- Comportamento ---
CASAS=camara,senado
# máximo de posts gerados por dia
MAX_POSTS=2
# quantos dias para trás olhar a cada execução (pega dados publicados com atraso)
JANELA_DIAS=3
# não repete a mesma proposição dentro desse prazo
INTERVALO_PROPOSICAO_DIAS=7
# gera uma pauta fria se ficar esse número de dias sem post (0 desliga)
DIAS_SEM_POST_PARA_FRIA=3
# 1 = avisa no Telegram quando não houver votação no dia
AVISAR_SEM_VOTACAO=0
# 1 = não publica de verdade, só mostra no log
DRY_RUN=0

# --- Teste "Quem vota como você?" (CTA nos posts) ---
# endereço do site do teste; vazio = sem slide e sem linha de chamada
SITE_TESTE_URL=
# 0 = não colocar a chamada mesmo com o site no ar
CTA_TESTE=1

# --- TikTok ---
# 0 = não gerar a versão 9:16 dos posts
TIKTOK_EXPORT=1
# manual (padrão: pacote no Telegram) | rascunho (caixa de entrada do app) | direto (privado até a auditoria)
TIKTOK_MODO=manual
# app criado em developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# gerado pelo `python main.py tiktok-login`; vale 365 dias e pode mudar a cada renovação
TIKTOK_REFRESH_TOKEN=
# endereço de retorno do login cadastrado no app (a página site/tiktok-callback/)
TIKTOK_REDIRECT_URI=https://seu-dominio.com.br/tiktok-callback/
# onde o TikTok baixa as imagens: precisa ser um domínio VERIFICADO no portal do TikTok
TIKTOK_MIDIA_URL=https://seu-dominio.com.br/midia
# só no modo direto; precisa estar entre as opções da conta (sem auditoria, só SELF_ONLY)
TIKTOK_PRIVACIDADE=SELF_ONLY

# --- Repost dos explicadores que performaram ---
# um explicador só volta depois desse número de dias
REPOST_APOS_DIAS=60
